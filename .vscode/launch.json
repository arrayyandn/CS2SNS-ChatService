{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Server",
      "request": "launch",
      "mainClass": "chat.ChatServer",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "java",
      "name": "Server (TLS)",
      "request": "launch",
      "mainClass": "chat.ChatServer",
      "args": "--tls",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "java",
      "name": "Client",
      "request": "launch",
      "mainClass": "chat.ChatClient",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "java",
      "name": "Client (TLS)",
      "request": "launch",
      "mainClass": "chat.ChatClient",
      "args": "--tls",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "java",
      "name": "Run Current File",
      "request": "launch",
      "mainClass": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
